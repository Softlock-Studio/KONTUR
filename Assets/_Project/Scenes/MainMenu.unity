    \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B\u0438, \u0447\u0442\u043E
    \u043F\u0440\u0438 \u0443\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0438 \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u044F
    \u0432 \u0437\u0430\u0434\u0430\u043D\u043D\u043E\u043C \u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D\u0435
    \u0433\u0440\u0438\u0431\u043E\u043A \u041E-41 \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u0442
    \u0441\u043F\u043E\u0440\u043E\u0432\u044B\u0439 \u0441\u0443\u0431\u0441\u0442\u0440\u0430\u0442
    \u0442\u0440\u0435\u0431\u0443\u0435\u043C\u043E\u0439 \u0447\u0438\u0441\u0442\u043E\u0442\u044B
    \u0434\u043B\u044F \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0433\u043E
    \u0441\u0438\u043D\u0442\u0435\u0437\u0430 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0430
    <b>\xAB\u0421\u043F\u043E\u0440\u0438\u043D\u043E\u043B\xBB</b>. \u041F\u043E\u043B\u043D\u043E\u0435
    \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u044F
    \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u043E \u043D\u0435\u0446\u0435\u043B\u0435\u0441\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u043C.\n\u0414\u043B\u044F
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u041E\u0431\u044A\u0435\u043A\u0442\u0430 \u0432 \u043E\u0434\u043D\u043E\u0439
    \u0438\u0437 \u043A\u0432\u0430\u0440\u0442\u0438\u0440 \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0430
    <b>\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u0430\u044F
    \u0437\u0430\u0440\u0430\u0436\u0451\u043D\u043D\u0430\u044F</b> \u2014 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u0446\u0430
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F
    \u0441\u043F\u043E\u0440\u043E\u0432\u043E\u0433\u043E \u0441\u0438\u043D\u0434\u0440\u043E\u043C\u0430.
    \u041E\u043D\u0430 \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E \u043D\u0435
    \u0438\u0437\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0430 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E:
    \u0435\u0451 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
    \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442 \u0440\u043E\u0441\u0442 \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u044F
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u043C
    \u043E\u0431\u0440\u0430\u0437\u043E\u043C. <color=#C0392B>\u041A\u043E\u043D\u0442\u0430\u043A\u0442
    \u0441 \u043D\u0435\u0439 \u043A\u0440\u0430\u0439\u043D\u0435 \u043D\u0435\u0436\u0435\u043B\u0430\u0442\u0435\u043B\u0435\u043D.</color>
    \n\n<b>\u0426\u0435\u043B\u044C \u0441\u043C\u0435\u043D\u044B:</b> \n\u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C
    \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0434\u043E\u043C\u0430
    \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435 [<color=#C0392B>\u043D\u0438\u0436\u043D\u0438\u0439
    \u043F\u043E\u0440\u043E\u0433</color>; <color=#C0392B>\u0432\u0435\u0440\u0445\u043D\u0438\u0439
    \u043F\u043E\u0440\u043E\u0433</color>] \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430.
    \u041E\u0442\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435 \u0432 \u043B\u044E\u0431\u0443\u044E
    \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u2014 \u043F\u0440\u043E\u0432\u0430\u043B.
    \n\n<b>\u041A\u0440\u0430\u0442\u043A\u0430\u044F \u0441\u043F\u0440\u0430\u0432\u043A\u0430
    \u043F\u043E \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044E \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435\u043C:</b>
    \n\u2014 \u041A\u0430\u043C\u0435\u0440\u044B: \u0432\u044B\u0431\u043E\u0440
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0439 \u043A\u0430\u043C\u0435\u0440\u044B
    \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0447\u0435\u0440\u0435\u0437 \u043C\u0438\u043D\u0438-\u043A\u0430\u0440\u0442\u0443.
    \n\u2014 \u041C\u0438\u043D\u0438-\u043A\u0430\u0440\u0442\u0430: \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442
    \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
    \u0438 \u0442\u0435\u043A\u0443\u0449\u0438\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
    \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u043A\u0430\u0436\u0434\u043E\u0439
    \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B. \n\u2014 \u041E\u0442\u0440\u044F\u0434:
    \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430,
    \u0437\u0430\u0442\u0435\u043C \u043A\u043E\u043C\u043D\u0430\u0442\u0443 \u0438
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435.
    \n\u2014 \u041E\u0431\u0449\u0438\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
    \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u044F: \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u043F\u0430\u043D\u0435\u043B\u0438.
    \u0414\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u044B\u0439 \u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D
    \u043E\u0442\u043C\u0435\u0447\u0435\u043D \u0446\u0432\u0435\u0442\u043E\u043C.
    \n\n<b>\u041F\u043E\u043C\u043D\u0438\u0442\u0435:</b> \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u0435
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0447\u0430\u0441\u0442\u044C\u044E
    \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430. \u0412\u0430\u0448\u0430
    \u0437\u0430\u0434\u0430\u0447\u0430 <b>\u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u0435\u0433\u043E, \u0430 \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043F\u043E\u0434
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C.</b> \n\n<color=#7F8C8D>\u041A.\u041E.\u041D.\u0422.\u0423.\u0420.
    \u2014 \u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u041E\u0431\u044A\u0435\u043A\u0442\u043E\u0432
    \u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0422\u0438\u043F\u0430
    \u0438 \u0423\u0441\u043B\u043E\u0432\u043D\u043E\u0439 \u0420\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438</color>
    \n\""
