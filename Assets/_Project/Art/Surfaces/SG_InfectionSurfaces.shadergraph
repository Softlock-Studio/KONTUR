{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "88a88da6239d4baaab2063dc8af96e19",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "RoomInfection (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -276.666748046875,
            "y": 544.6666870117188,
            "width": 244.00001525878907,
            "height": 311.99993896484377
        }
    },
    "m_Slots": [
        {
            "m_Id": "0748270b641548a9800be5c1c06aca43"
        },
        {
            "m_Id": "156ba5cf2843448ca9a2c045ce1e1c9b"
        },
        {
            "m_Id": "fac67b8ea2fa434aaed4a591a72cd893"
        },
        {
            "m_Id": "5d03800f5fd3458cb0dd738e63dadd94"
        },
        {
            "m_Id": "e65813a20d1d4919b9a83a5f7d111909"
        },
        {
            "m_Id": "b1349e73e35744a293f0572bdb1208a5"
        },
        {
            "m_Id": "5f0508fa585c408e871093f37aa93356"
        },
        {
            "m_Id": "eb99581541f84e9c89092edaef9eb923"
        },
        {
            "m_Id": "17faaa17879947a5bab18735006fe027"
        },
        {
            "m_Id": "275f90a415314ec6a6700ee9e1d7982a"
        },
        {
            "m_Id": "bd20155799c94417a134cb1865d79a8c"
        },
        {
            "m_Id": "1a91076f9de84933b6139fa1f453ded4"
        },
        {
            "m_Id": "c2a7c76478ff46d386d221bcb644b4fb"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "RoomInfection",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 seed = frac(UV * 0.37);\r\n\r\n// основной шум — сама текстура грязи (мелкий, детальный узор)\r\nfloat noise = SAMPLE_TEXTURE2D(NoiseTex.tex, Sampler.samplerstate, UV * NoiseScale + seed).r;\r\n\r\n// второй, крупный шум — маска \"где вообще разрешено рисовать грязь\"\r\nfloat maskNoise = SAMPLE_TEXTURE2D(NoiseTex.tex, Sampler.samplerstate, UV * MaskNoiseScale + 0.5).r;\r\nfloat allowMask = step(MaskThreshold, maskNoise);\r\n\r\nfloat capped = max(MaxEffectiveInfection, 0.001);\r\nfloat infection = saturate(Infection / capped);\r\n\r\nfloat threshold = 1.0 - infection;\r\nfloat s = max(Softness, 0.001);\r\nfloat edge0 = threshold - s;\r\nfloat edge1 = threshold + s;\r\n\r\nfloat dirtMask = smoothstep(edge0, edge1, noise);\r\ndirtMask *= allowMask;\r\n\r\nColor = DirtColor.rgb;\r\nAlpha = dirtMask * DirtColor.a;"
}

