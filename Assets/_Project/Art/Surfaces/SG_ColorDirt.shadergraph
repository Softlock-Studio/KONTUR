{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "75631026635c401ca452da0ea36c2964",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "TriplanarBase (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -286.3999328613281,
            "y": 847.2000122070313,
            "width": 232.79998779296876,
            "height": 357.60003662109377
        }
    },
    "m_Slots": [
        {
            "m_Id": "7da168418dd04dcf90e144b8510085eb"
        },
        {
            "m_Id": "3d4c12d540c24072ad06cefc6f8f4308"
        },
        {
            "m_Id": "f8c5e952a92c4915b3ac641919dea3d9"
        },
        {
            "m_Id": "4868f72ca28e4a70b175eaad7effd0ab"
        },
        {
            "m_Id": "b0c34e7af5554319ba25169b83929168"
        },
        {
            "m_Id": "721f2b1ae0a54050a7cb48d340134858"
        },
        {
            "m_Id": "f4775c9a3dc546d9b18b207b91920c57"
        },
        {
            "m_Id": "db65849bc68a47a7a76ad71eb19959a0"
        },
        {
            "m_Id": "ab21f2b757c344bfabc25fc1b7c0524e"
        },
        {
            "m_Id": "2b38782a06e844f8bdc065626dc9a99f"
        },
        {
            "m_Id": "be1f5815e0c140f585b0ee4ff1bac83d"
        },
        {
            "m_Id": "65dd382e6fc44a999ca00b332365fdea"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "TriplanarBase",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 n = abs(WorldNormal);\r\nn = pow(n, Blend);\r\nn /= (n.x + n.y + n.z + 1e-5);\r\n\r\n// небольшое случайное смещение координат, чтобы сбить видимый шов текстуры грязи\r\nfloat2 dp = WorldPos.xz * DistScale;\r\nfloat noiseOffset = frac(sin(dot(dp, float2(12.9898, 78.233))) * 43758.5453);\r\nfloat3 distortedPos = WorldPos + noiseOffset * DistStrength;\r\n\r\n// трипланарный сэмплинг грязи (текстура чб, берём красный канал как маску)\r\nfloat dirtX = SAMPLE_TEXTURE2D(DirtTex.tex, Sampler.samplerstate, distortedPos.yz * DirtTiling).r;\r\nfloat dirtY = SAMPLE_TEXTURE2D(DirtTex.tex, Sampler.samplerstate, distortedPos.xz * DirtTiling).r;\r\nfloat dirtZ = SAMPLE_TEXTURE2D(DirtTex.tex, Sampler.samplerstate, distortedPos.xy * DirtTiling).r;\r\nfloat dirtMask = saturate((dirtX * n.x + dirtY * n.y + dirtZ * n.z) * DirtIntensity);\r\n\r\nOut = lerp(BaseColor, DirtColor, dirtMask);\n"
}

