    "m_FunctionBody": "// ------------------------------------------------------------\r\n// TRIPLANAR BLEND WEIGHTS\r\n// ------------------------------------------------------------\r\n\r\nfloat3 weights = abs(WorldNormal);\r\n\r\nweights = pow(\r\n    weights,\r\n    max(Blend, 0.001)\r\n);\r\n\r\nweights /= max(\r\n    weights.x\r\n    + weights.y\r\n    + weights.z,\r\n    0.0001\r\n);\r\n\r\n\r\n// ------------------------------------------------------------\r\n// BASE TEXTURE\r\n// ------------------------------------------------------------\r\n\r\nfloat3 colorX = SAMPLE_TEXTURE2D(\r\n    BaseTex.tex,\r\n    BaseTex.samplerstate,\r\n    WorldPos.zy * Tiling\r\n).rgb;\r\n\r\nfloat3 colorY = SAMPLE_TEXTURE2D(\r\n    BaseTex.tex,\r\n    BaseTex.samplerstate,\r\n    WorldPos.xz * Tiling\r\n).rgb;\r\n\r\nfloat3 colorZ = SAMPLE_TEXTURE2D(\r\n    BaseTex.tex,\r\n    BaseTex.samplerstate,\r\n    WorldPos.xy * Tiling\r\n).rgb;\r\n\r\n\r\nfloat3 baseColor =\r\n      colorX * weights.x\r\n    + colorY * weights.y\r\n    + colorZ * weights.z;\r\n\r\n\r\n// ------------------------------------------------------------\r\n// DIRT TEXTURE\r\n// ------------------------------------------------------------\r\n\r\nfloat dirtX = SAMPLE_TEXTURE2D(\r\n    DirtTex.tex,\r\n    DirtTex.samplerstate,\r\n    WorldPos.zy * DirtTiling\r\n).r;\r\n\r\nfloat dirtY = SAMPLE_TEXTURE2D(\r\n    DirtTex.tex,\r\n    DirtTex.samplerstate,\r\n    WorldPos.xz * DirtTiling\r\n).r;\r\n\r\nfloat dirtZ = SAMPLE_TEXTURE2D(\r\n    DirtTex.tex,\r\n    DirtTex.samplerstate,\r\n    WorldPos.xy * DirtTiling\r\n).r;\r\n\r\n\r\nfloat dirtMask =\r\n      dirtX * weights.x\r\n    + dirtY * weights.y\r\n    + dirtZ * weights.z;\r\n\r\n\r\n// ------------------------------------------------------------\r\n// DIRT MASK\r\n// ------------------------------------------------------------\r\n\r\n// Black in DirtTex = dirt\r\n// White in DirtTex = clean\r\n\r\ndirtMask =\r\n    1.0 - dirtMask;\r\n\r\n\r\n// ------------------------------------------------------------\r\n// CELLULAR / VORONOI MASK\r\n// ------------------------------------------------------------\r\n\r\n// World-space position\r\n// NoiseScale changes cell size\r\n\r\nfloat3 noisePosition =\r\n    WorldPos * NoiseScale;\r\n\r\n\r\n// Cell coordinates\r\nfloat3 cell =\r\n    floor(noisePosition);\r\n\r\n\r\n// Position inside current cell\r\nfloat3 localPosition =\r\n    frac(noisePosition);\r\n\r\n\r\n// Start with large distance\r\nfloat nearestDistance =\r\n    100.0;\r\n\r\n\r\n// Search neighboring cells\r\nfor (int x = -1; x <= 1; x++)\r\n{\r\n    for (int y = -1; y <= 1; y++)\r\n    {\r\n        for (int z = -1; z <= 1; z++)\r\n        {\r\n            float3 cellOffset =\r\n                float3(x, y, z);\r\n\r\n\r\n            float3 randomPoint =\r\n                frac(\r\n                    sin(\r\n                        float3(\r\n                            dot(\r\n                                cell + cellOffset,\r\n                                float3(\r\n                                    127.1,\r\n                                    311.7,\r\n                                    74.7\r\n                                )\r\n                            ),\r\n\r\n                            dot(\r\n                                cell + cellOffset,\r\n                                float3(\r\n                                    269.5,\r\n                                    183.3,\r\n                                    246.1\r\n                                )\r\n                            ),\r\n\r\n                            dot(\r\n                                cell + cellOffset,\r\n                                float3(\r\n                                    113.5,\r\n                                    271.9,\r\n                                    124.6\r\n                                )\r\n                            )\r\n                        )\r\n                    )\r\n                    * 43758.5453\r\n                );\r\n\r\n\r\n            float3 pointPosition =\r\n                cellOffset\r\n                + randomPoint;\r\n\r\n\r\n            float3 difference =\r\n                pointPosition\r\n                - localPosition;\r\n\r\n\r\n            float distanceToPoint =\r\n                dot(\r\n                    difference,\r\n                    difference\r\n                );\r\n\r\n\r\n            nearestDistance =\r\n                min(\r\n                    nearestDistance,\r\n                    distanceToPoint\r\n                );\r\n        }\r\n    }\r\n}\r\n\r\n\r\n// Convert distance into a mask\r\nfloat voronoiMask =\r\n    saturate(\r\n        sqrt(nearestDistance)\r\n        * 2.0\r\n    );\r\n\r\n\r\n// ------------------------------------------------------------\r\n// USE VORONOI AS DIRT DISTRIBUTION\r\n// ------------------------------------------------------------\r\n\r\n// Voronoi:\r\n// 0 = center of cell\r\n// 1 = far from cell center\r\n\r\n// Invert:\r\n// 1 = center of cell\r\n// 0 = between cells\r\n\r\nfloat voronoiDirt =\r\n    1.0 - voronoiMask;\r\n\r\n\r\n// Make Voronoi influence adjustable\r\nfloat voronoiFactor =\r\n    lerp(\r\n        1.0,\r\n        voronoiDirt,\r\n        NoiseStrength\r\n    );\r\n\r\n\r\n// Apply Voronoi distribution to dirt\r\ndirtMask *= voronoiFactor;\r\n\r\n\r\n// ------------------------------------------------------------\r\n// DIRT INTENSITY\r\n// ------------------------------------------------------------\r\n\r\ndirtMask =\r\n    saturate(\r\n        dirtMask\r\n        * DirtIntensity\r\n    );\r\n\r\n\r\n// ------------------------------------------------------------\r\n// DIRT COLOR\r\n// ------------------------------------------------------------\r\n\r\nfloat3 dirtColor =\r\n    DirtColor.rgb;\r\n\r\n\r\n// Preserve brightness\r\nfloat baseLuminance =\r\n    dot(\r\n        baseColor,\r\n        float3(\r\n            0.299,\r\n            0.587,\r\n            0.114\r\n        )\r\n    );\r\n\r\n\r\n// Colored dirt\r\nfloat3 coloredDirt =\r\n    dirtColor\r\n    * baseLuminance;\r\n\r\n\r\n// ------------------------------------------------------------\r\n// FINAL OUTPUT\r\n// ------------------------------------------------------------\r\n\r\nOut =\r\n    lerp(\r\n        baseColor,\r\n        coloredDirt,\r\n        dirtMask\r\n    );"
}

