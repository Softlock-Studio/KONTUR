        },
        {
            "m_Id": "86807690aa364d738f9f2db97a95dd4c"
        },
        {
            "m_Id": "e0f97804e66247d3b0be0499970bab23"
        },
        {
            "m_Id": "48711d6e50034155ba9643c6c1b24d7a"
        },
        {
            "m_Id": "d979e3ab0c7844bd9504521764007dce"
        },
        {
            "m_Id": "43f972f69c7b4af5963000242f9ac31e"
        },
        {
            "m_Id": "2ca84bca748c47858261173daa76576a"
        },
        {
            "m_Id": "e5052c458f8a460c8010956f75d3a2d2"
        },
        {
            "m_Id": "65dd382e6fc44a999ca00b332365fdea"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "TriplanarBase",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// ------------------------------------------------------------\r\n// TRIPLANAR BLEND WEIGHTS\r\n// ------------------------------------------------------------\r\n\r\nfloat3 weights = abs(WorldNormal);\r\nweights = pow(weights, max(Blend, 0.001));\r\nweights /= max(weights.x + weights.y + weights.z, 0.0001);\r\n\r\n\r\n// ------------------------------------------------------------\r\n// BASE TEXTURE (обои / пол)\r\n// ------------------------------------------------------------\r\n\r\nfloat3 colorX = SAMPLE_TEXTURE2D(BaseTex.tex, BaseSampler.samplerstate, WorldPos.zy * Tiling).rgb;\r\nfloat3 colorY = SAMPLE_TEXTURE2D(BaseTex.tex, BaseSampler.samplerstate, WorldPos.xz * Tiling).rgb;\r\nfloat3 colorZ = SAMPLE_TEXTURE2D(BaseTex.tex, BaseSampler.samplerstate, WorldPos.xy * Tiling).rgb;\r\n\r\nfloat3 baseColor = colorX * weights.x + colorY * weights.y + colorZ * weights.z;\r\n\r\n\r\n// ------------------------------------------------------------\r\n// STATIC DIRT (потёртости, всегда есть, не зависит от скрипта)\r\n// ------------------------------------------------------------\r\n\r\nfloat dirtX = SAMPLE_TEXTURE2D(DirtTex.tex, DirtSampler.samplerstate, WorldPos.zy * DirtTiling).r;\r\nfloat dirtY = SAMPLE_TEXTURE2D(DirtTex.tex, DirtSampler.samplerstate, WorldPos.xz * DirtTiling).r;\r\nfloat dirtZ = SAMPLE_TEXTURE2D(DirtTex.tex, DirtSampler.samplerstate, WorldPos.xy * DirtTiling).r;\r\n\r\nfloat staticDirtMask = dirtX * weights.x + dirtY * weights.y + dirtZ * weights.z;\r\nstaticDirtMask = 1.0 - staticDirtMask;\r\n\r\n\r\n// ------------------------------------------------------------\r\n// VORONOI DISTRIBUTION ДЛЯ STATIC DIRT\r\n// ------------------------------------------------------------\r\n\r\nfloat3 noisePosition = WorldPos * VoronoiScale;\r\nfloat3 cell = floor(noisePosition);\r\nfloat3 localPosition = frac(noisePosition);\r\n\r\nfloat nearestDistance = 100.0;\r\n\r\nfor (int x = -1; x <= 1; x++)\r\n{\r\n    for (int y = -1; y <= 1; y++)\r\n    {\r\n        for (int z = -1; z <= 1; z++)\r\n        {\r\n            float3 cellOffset = float3(x, y, z);\r\n\r\n            float3 randomPoint = frac(sin(float3(\r\n                dot(cell + cellOffset, float3(127.1, 311.7, 74.7)),\r\n                dot(cell + cellOffset, float3(269.5, 183.3, 246.1)),\r\n                dot(cell + cellOffset, float3(113.5, 271.9, 124.6))\r\n            )) * 43758.5453);\r\n\r\n            float3 pointPosition = cellOffset + randomPoint;\r\n            float3 difference = pointPosition - localPosition;\r\n            float distanceToPoint = dot(difference, difference);\r\n\r\n            nearestDistance = min(nearestDistance, distanceToPoint);\r\n        }\r\n    }\r\n}\r\n\r\nfloat voronoiMask = saturate(sqrt(nearestDistance) * 2.0);\r\nfloat voronoiDirt = 1.0 - voronoiMask;\r\nfloat voronoiFactor = lerp(1.0, voronoiDirt, VoronoiStrength);\r\n\r\nstaticDirtMask *= voronoiFactor;\r\nstaticDirtMask = saturate(staticDirtMask * DirtIntensity);\r\n\r\n\r\n// ------------------------------------------------------------\r\n// ПРИМЕНЯЕМ STATIC DIRT К BASE COLOR\r\n// ------------------------------------------------------------\r\n\r\nfloat baseLuminance = dot(baseColor, float3(0.299, 0.587, 0.114));\r\nfloat3 coloredStaticDirt = StaticDirtColor.rgb * baseLuminance;\r\n\r\nfloat3 wallWithStaticDirt = lerp(baseColor, coloredStaticDirt, staticDirtMask);\r\n\r\n\r\n// ------------------------------------------------------------\r\n// INFECTION DIRT (второй слой, зависит от скрипта)\r\n// ------------------------------------------------------------\r\n\r\nfloat2 seed = frac(UV * 0.37);\r\n\r\nfloat infNoise = SAMPLE_TEXTURE2D(InfectionDirtTex.tex, InfectionSampler.samplerstate, UV * InfectionNoiseScale + seed).r;\r\nfloat maskNoise = SAMPLE_TEXTURE2D(InfectionDirtTex.tex, InfectionSampler.samplerstate, UV * MaskNoiseScale + 0.5).r;\r\nfloat allowMask = step(MaskThreshold, maskNoise);\r\n\r\nfloat capped = max(MaxEffectiveInfection, 0.001);\r\nfloat infection = saturate(Infection / capped);\r\n\r\nfloat threshold = 1.0 - infection;\r\nfloat s = max(Softness, 0.001);\r\nfloat edge0 = threshold - s;\r\nfloat edge1 = threshold + s;\r\n\r\nfloat infectionMask = smoothstep(edge0, edge1, infNoise);\r\ninfectionMask *= allowMask;\r\n\r\n// убираем остаточный шум при низком Infection (чистота при 0)\r\ninfectionMask = saturate((infectionMask - MinNoiseCutoff) / max(1.0 - MinNoiseCutoff, 0.001));\r\n\r\n// отдельно управляем яркостью/насыщенностью на пике\r\ninfectionMask *= MaxIntensity;\r\n\r\n\r\n// ------------------------------------------------------------\r\n// ФИНАЛЬНОЕ СМЕШИВАНИЕ: BASE + STATIC DIRT + INFECTION DIRT\r\n// ------------------------------------------------------------\r\n\r\nOut = lerp(wallWithStaticDirt, InfectionDirtColor.rgb, infectionMask);"
}

