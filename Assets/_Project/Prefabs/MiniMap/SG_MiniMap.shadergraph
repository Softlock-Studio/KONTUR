    },
    "m_Name": "Custom_Functio (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -277.3333740234375,
            "y": 547.3334350585938,
            "width": 246.6667022705078,
            "height": 432.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "0417fa8de7ce45d693e9cbc09d775be0"
        },
        {
            "m_Id": "268282dc04eb4cb6b0e6a09f96c71da3"
        },
        {
            "m_Id": "63c55701cd3e4ff4a2e373046fdf7b8f"
        },
        {
            "m_Id": "c48d9f72cbfe4e769dd0ef5b38865517"
        },
        {
            "m_Id": "be9b3994cfb64f74abfcd8d1d708ddbf"
        },
        {
            "m_Id": "4c27ea8726234416bf71ad8cb4984314"
        },
        {
            "m_Id": "6b7ad09c99b8486cbec013924b4b8346"
        },
        {
            "m_Id": "d90ca8f93d9a4f8ab60bc4364767d1b7"
        },
        {
            "m_Id": "6ecf5eb839a54ff0b587861c85321d58"
        },
        {
            "m_Id": "f3f8fbf8a7d243e483efff0d151b74c8"
        },
        {
            "m_Id": "529dadd5b8334f50bfbee6191f1e2dbe"
        },
        {
            "m_Id": "42464352c94b49989c29a81a23d0610c"
        },
        {
            "m_Id": "c0d03141767944c58057f5a8fc7454a1"
        },
        {
            "m_Id": "ef14788cfe164284b8d21c97f859c34c"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Custom_Functio",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 seed = frac(WorldPos.xz * 0.37);\r\n\r\nfloat2 sizePx = PlaneSize;\r\nfloat distLeft   = UV.x * sizePx.x;\r\nfloat distRight  = (1.0 - UV.x) * sizePx.x;\r\nfloat distBottom = UV.y * sizePx.y;\r\nfloat distTop    = (1.0 - UV.y) * sizePx.y;\r\n\r\ndistLeft   = lerp(1e5, distLeft,   EdgeMask.x);\r\ndistRight  = lerp(1e5, distRight,  EdgeMask.y);\r\ndistBottom = lerp(1e5, distBottom, EdgeMask.z);\r\ndistTop    = lerp(1e5, distTop,    EdgeMask.w);\r\n\r\nfloat edgeDist = min(min(distLeft, distRight), min(distBottom, distTop));\r\n\r\nfloat edgeNoise = SAMPLE_TEXTURE2D(NoiseTex.tex, Sampler.samplerstate, WorldPos.xz * EdgeNoiseScale + seed).r;\r\nfloat jitter = (edgeNoise - 0.5) * EdgeNoiseStrength;\r\n\r\nfloat borderMask = 1.0 - smoothstep(BorderThickness * 0.8 + jitter, BorderThickness + jitter, edgeDist);\r\n\r\nfloat noise = SAMPLE_TEXTURE2D(NoiseTex.tex, Sampler.samplerstate, WorldPos.xz * NoiseScale + seed).r;\r\nfloat3 noisyFill = FillColor + (noise - 0.5) * NoiseIntensity;\r\n\r\nOut = lerp(noisyFill, BorderColor, borderMask);"
}

