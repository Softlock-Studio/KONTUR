{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "88a88da6239d4baaab2063dc8af96e19",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "RoomInfection (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -277.3332824707031,
            "y": 537.3333129882813,
            "width": 237.33334350585938,
            "height": 216.00006103515626
        }
    },
    "m_Slots": [
        {
            "m_Id": "0748270b641548a9800be5c1c06aca43"
        },
        {
            "m_Id": "7aa537e5aff04a3f82b941c74104a14b"
        },
        {
            "m_Id": "156ba5cf2843448ca9a2c045ce1e1c9b"
        },
        {
            "m_Id": "fac67b8ea2fa434aaed4a591a72cd893"
        },
        {
            "m_Id": "5d03800f5fd3458cb0dd738e63dadd94"
        },
        {
            "m_Id": "e65813a20d1d4919b9a83a5f7d111909"
        },
        {
            "m_Id": "b1349e73e35744a293f0572bdb1208a5"
        },
        {
            "m_Id": "5f0508fa585c408e871093f37aa93356"
        },
        {
            "m_Id": "e57d4d4b62da4991b4d84989603fa1fc"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "RoomInfection",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 seed = frac(WorldPos.xz * 0.37);\r\n\r\nfloat noise = SAMPLE_TEXTURE2D(NoiseTex.tex, Sampler.samplerstate, WorldPos.xz * NoiseScale + seed).r;\r\n\r\n// чем выше Infection, тем ниже порог — тем больше area закрашено грязью\r\nfloat threshold = 1.0 - saturate(Infection);\r\nfloat dirtMask = smoothstep(threshold - Softness, threshold + Softness, noise);\r\n\r\nOut = lerp(FloorColor.rgb, DirtColor.rgb, dirtMask);"
}

